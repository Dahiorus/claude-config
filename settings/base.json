{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/bash-rewrite-hook.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/main-guard-hook.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "jq -n --rawfile m ~/.claude/session-intro.md \"{systemMessage: \\$m}\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "chrome-devtools-mcp@claude-plugins-official": false,
    "atlassian@claude-plugins-official": true,
    "sonarqube@claude-plugins-official": true,
    "plannotator@plannotator": true,
    "ponytail@ponytail": true,
    "shortcuts@claude-config": true,
    "skill-creator@anthropic-plugin-directory": false,
    "vercel@anthropic-plugin-directory": false,
    "security-guidance@anthropic-plugin-directory": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-code-setup@anthropic-plugin-directory": false,
    "figma@claude-plugins-official": false,
    "commit-commands@anthropic-plugin-directory": false,
    "php-lsp@claude-plugins-official": true,
    "caveman-mode-short-answers@anthropic-plugin-directory": true,
    "claude-md-management@anthropic-plugin-directory": true,
    "jk@harnais": true,
    "context7@claude-plugins-official": true,
    "humanizer@harnais": true
  },
  "extraKnownMarketplaces": {
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "claude-config": {
      "source": {
        "source": "github",
        "repo": "Dahiorus/claude-config"
      }
    },
    "harnais": {
      "source": {
        "source": "github",
        "repo": "softwarevidal/harnais"
      }
    }
  },
  "language": "French",
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": 250000
    }
  },
  "theme": "dark",
  "editorMode": "normal",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": true,
  "autoContinueAtUsageLimit": false
}
