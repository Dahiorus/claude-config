{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "ReportFindings",
      "SendFeedback",
      "ShareOnboardingGuide"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/bash-rewrite-hook.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/main-guard-hook.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "f=~/.claude/hooks/sonar-secrets/build-scripts/pretool-secrets.sh; [ ! -x \"$f\" ] || \"$f\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "jq -n --rawfile m ~/.claude/session-intro.md \"{systemMessage: \\$m}\""
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/profile.sh session-start"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/dirty-skills-hook.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=~/.claude/hooks/sonar-secrets/build-scripts/prompt-secrets.sh; [ ! -x \"$f\" ] || \"$f\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "chrome-devtools-mcp@claude-plugins-official": false,
    "atlassian@claude-plugins-official": true,
    "sonarqube@claude-plugins-official": false,
    "plannotator@plannotator": true,
    "ponytail@ponytail": true,
    "shortcuts@claude-config": true,
    "skill-creator@anthropic-plugin-directory": false,
    "vercel@anthropic-plugin-directory": false,
    "security-guidance@anthropic-plugin-directory": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-code-setup@anthropic-plugin-directory": false,
    "figma@claude-plugins-official": false,
    "commit-commands@anthropic-plugin-directory": false,
    "php-lsp@claude-plugins-official": true,
    "caveman-mode-short-answers@anthropic-plugin-directory": true,
    "claude-md-management@anthropic-plugin-directory": true,
    "jk@harnais": true,
    "context7@claude-plugins-official": true,
    "humanizer@harnais": true,
    "jdtls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "claude-config": {
      "source": {
        "source": "github",
        "repo": "Dahiorus/claude-config"
      }
    },
    "harnais": {
      "source": {
        "source": "github",
        "repo": "softwarevidal/harnais"
      }
    }
  },
  "language": "French",
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": 250000
    },
    "claude-sonnet-5-5": {
      "autoCompactWindow": 250000
    }
  },
  "theme": "dark",
  "editorMode": "normal",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": true,
  "autoContinueAtUsageLimit": false,
  "skipWorkflowUsageWarning": true,
  "skillOverrides": {
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "superpowers:diagnosing-superpowers": "off",
    "superpowers:dispatching-parallel-agents": "off",
    "superpowers:requesting-code-review": "off",
    "superpowers:verification-before-completion": "off",
    "ponytail:ponytail-help": "off",
    "plannotator-last": "off",
    "dataviz": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:docs": "off"
  },
  "model": "opus"
}
